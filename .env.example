# Copy this file to .env and fill in the settings for your provider.
# Offline tests and benchmarks do not require API keys.

# Supported: openai, custom, gemini, anthropic, ollama, openrouter
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0

# OpenAI
OPENAI_API_KEY=

# Custom OpenAI-compatible endpoint
CUSTOM_BASE_URL=http://localhost:8000/v1
CUSTOM_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Ollama (local; no API key required)
OLLAMA_BASE_URL=http://localhost:11434

# OpenRouter (base URL is configured in code)
OPENROUTER_API_KEY=

# If LLM_MODEL is omitted or empty, load_config() selects a provider default.
# Otherwise, set it to a model available on your selected provider.
